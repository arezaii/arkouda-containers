#!/bin/bash

set -euo pipefail

export CHPL_HOME="${CHPL_HOME:-/opt/chapel}"

if [[ -d "/opt/libfabric/bin" ]]; then
    export PATH="/opt/libfabric/bin:${PATH}"
fi

if [[ -d "${CHPL_HOME}/bin/linux64-x86_64" ]]; then
    export PATH="${CHPL_HOME}/bin/linux64-x86_64:${CHPL_HOME}/util:${PATH}"
elif [[ -d "${CHPL_HOME}/bin" ]]; then
    export PATH="${CHPL_HOME}/bin:${CHPL_HOME}/util:${PATH}"
fi

if [[ -d "/opt/libfabric/lib" ]]; then
    export LD_LIBRARY_PATH="/opt/libfabric/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
    export LIBRARY_PATH="/opt/libfabric/lib${LIBRARY_PATH:+:${LIBRARY_PATH}}"
    export CPATH="/opt/libfabric/include${CPATH:+:${CPATH}}"
    export PKG_CONFIG_PATH="/opt/libfabric/lib/pkgconfig${PKG_CONFIG_PATH:+:${PKG_CONFIG_PATH}}"
    export LIBFABRIC_DIR="/opt/libfabric"
fi

if [[ -d "/opt/cxi-dev/lib" ]]; then
    export LD_LIBRARY_PATH="/opt/cxi-dev/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
    export LIBRARY_PATH="/opt/cxi-dev/lib${LIBRARY_PATH:+:${LIBRARY_PATH}}"
    export CPATH="/opt/cxi-dev/include${CPATH:+:${CPATH}}"
    export PKG_CONFIG_PATH="/opt/cxi-dev/lib/pkgconfig${PKG_CONFIG_PATH:+:${PKG_CONFIG_PATH}}"
fi

show_usage() {
    cat <<'EOF'
Usage:
  chapel-start [runtime] [command...]

Available runtimes:
  hpe-cray-ex  Build or run with OFI, PMI2, and CXI-aware libfabric
  linux64      Build or run with CHPL_COMM=none

Examples:
  chapel-start hpe-cray-ex chpl examples/hello6-taskpar-dist.chpl
  chapel-start linux64 chpl examples/hello.chpl
  chapel-start hpe-cray-ex bash
  chapel-start bash
EOF
}

setup_runtime() {
    local runtime=$1

    export CHPL_HOST_PLATFORM=linux64
    export CHPL_LLVM=system
    export CHPL_TARGET_COMPILER=llvm
    export CHPL_RE2=bundled
    export CHPL_TASKS=qthreads
    export CHPL_UNWIND=none

    case "$runtime" in
        hpe-cray-ex)
            export CHPL_TARGET_PLATFORM=hpe-cray-ex
            export CHPL_COMM=ofi
            export CHPL_LIBFABRIC=system
            export CHPL_COMM_OFI_OOB=pmi2
            export CHPL_LAUNCHER=slurm-srun
            export CHPL_LOCALE_MODEL=flat
            export CHPL_AUX_FILESYS=none
            export CHPL_RT_COMM_OFI_PROVIDER=cxi
            export CHPL_RT_COMM_OFI_OOB=pmi2
            ;;
        linux64)
            export CHPL_TARGET_PLATFORM=linux64
            export CHPL_COMM=none
            export CHPL_LIBFABRIC=none
            export CHPL_LAUNCHER=none
            unset CHPL_COMM_OFI_OOB
            unset CHPL_RT_COMM_OFI_PROVIDER
            unset CHPL_RT_COMM_OFI_OOB
            unset CHPL_AUX_FILESYS
            ;;
        *)
            echo "Unknown runtime '$runtime'" >&2
            show_usage >&2
            return 1
            ;;
    esac
}

# If requested, try to bring up container-local SLURM helpers before launching.
if [[ "${SLURM_CONTAINER_MODE:-false}" == "true" ]] && command -v slurmctld >/dev/null 2>&1; then
    export PATH="/usr/sbin:/usr/bin:${PATH}"

    mkdir -p /var/spool/slurm/ctld /var/spool/slurm/d /var/run/slurm /var/log/slurm /run/dbus
    chmod 755 /var/spool/slurm /var/spool/slurm/ctld /var/spool/slurm/d /var/run/slurm /var/log/slurm || true
    touch /var/spool/slurm/ctld/node_state \
        /var/spool/slurm/ctld/job_state \
        /var/spool/slurm/ctld/resv_state \
        /var/spool/slurm/ctld/trigger_state

    if command -v dbus-daemon >/dev/null 2>&1 && ! pgrep -x dbus-daemon >/dev/null 2>&1; then
        dbus-daemon --system --print-address >/dev/null 2>&1 || true
    fi

    if ! pgrep -x munged >/dev/null 2>&1; then
        service munge start 2>/dev/null || munged -f -D >/tmp/munged.log 2>&1 &
    fi

    if [[ -f /etc/slurm/slurm.conf ]]; then
        export SLURM_CONF=/etc/slurm/slurm.conf
        pgrep -x slurmctld >/dev/null 2>&1 || (slurmctld -D -f /etc/slurm/slurm.conf >/tmp/slurmctld.log 2>&1 &)
        pgrep -x slurmd >/dev/null 2>&1 || (slurmd -D -f /etc/slurm/slurm.conf >/tmp/slurmd.log 2>&1 &)
    fi
fi

if [[ $# -gt 0 ]] && [[ "$1" == "-h" || "$1" == "--help" ]]; then
    show_usage
    exit 0
fi

if [[ $# -gt 0 ]] && [[ "$1" == "hpe-cray-ex" || "$1" == "linux64" ]]; then
    setup_runtime "$1"
    shift
else
    setup_runtime hpe-cray-ex
fi

if [[ $# -gt 0 ]]; then
    exec "$@"
fi

exec /bin/bash