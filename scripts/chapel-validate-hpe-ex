#!/bin/bash

set -euo pipefail

if [[ -n "${CHPL_HOME:-}" && -d "${CHPL_HOME}/bin" ]]; then
    export PATH="${CHPL_HOME}/bin:${CHPL_HOME}/util:${PATH}"
fi

require_path() {
    local path="$1"
    if [[ ! -e "${path}" ]]; then
        echo "Missing required path: ${path}" >&2
        exit 1
    fi
}

require_absent() {
    local path="$1"
    if [[ -e "${path}" ]]; then
        echo "Unexpected path present: ${path}" >&2
        exit 1
    fi
}

require_lib_loadable() {
    local pattern="$1"
    local label="$2"
    if ! ldconfig -p 2>/dev/null | grep -q "${pattern}"; then
        echo "Missing required library: ${label} (searched via ldconfig for '${pattern}')" >&2
        exit 1
    fi
}

command -v chpl >/dev/null 2>&1 || {
    echo "chpl not found in PATH" >&2
    exit 1
}

require_path /opt/libfabric/lib/libfabric.so.1
# PMI2 comes from the distro's libpmi2-0-dev package (not a bundled /opt tree)
require_lib_loadable "libpmi2\.so" "PMI2 (libpmi2)"

if [[ -e /opt/cxi-dev/include/libcxi/libcxi.h ]]; then
    require_path /opt/cxi-dev/include/libcxi/libcxi.h
    require_path /opt/libfabric/include/rdma/fi_cxi_ext.h
else
    require_absent /opt/cxi-dev/include/libcxi/libcxi.h
    require_absent /opt/libfabric/include/rdma/fi_cxi_ext.h
fi

echo "Chapel: $(chpl --version | head -1)"
echo "LIBFABRIC_DIR=${LIBFABRIC_DIR:-/opt/libfabric}"
echo "FI_PROVIDER=${FI_PROVIDER:-unset}"

if [[ "${1:-}" != "--no-compile" ]]; then
    /usr/local/bin/chapel-test-compile
fi